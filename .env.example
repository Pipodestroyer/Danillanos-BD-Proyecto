# ==============================================================================
# DANILLANOS E-COMMERCE - PLANTILLA DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como .env y define tus propios valores de entorno.
# NUNCA compartas ni subas tu archivo .env real al repositorio de control de versiones.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Conexión a Base de Datos MySQL
# ------------------------------------------------------------------------------
# OPCIÓN A (Recomendada para Railway, Render o Producción): URI Unificada
# En Railway puedes enlazar el servicio MySQL directamente con ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://usuario_db:password_db@localhost:3306/nombre_basedatos

# OPCIÓN B (Tradicional / Local): Parámetros individuales separados
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=tu_password_local
# DB_NAME=nombre_basedatos
# DB_SSL=false

# ------------------------------------------------------------------------------
# Seguridad y Criptografía
# ------------------------------------------------------------------------------
# Clave simétrica de 256 bits (32 bytes o más) para cifrado AES-256-GCM en reposo
ENCRYPTION_KEY=tu_clave_secreta_de_cifrado_aes256_de_al_menos_32_caracteres_aqui

# Secreto criptográfico para firma y verificación de tokens de sesión JWT
JWT_SECRET=tu_clave_secreta_jwt_para_firmar_tokens_de_sesion_aqui

# ------------------------------------------------------------------------------
# Autenticación Google Identity Services (GIS OAuth 2.0)
# ------------------------------------------------------------------------------
# Client ID obtenido desde Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=tu_cliente_id_de_google_oauth_aqui.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Cuenta Administrativa Inicial (Admin)
# ------------------------------------------------------------------------------
# Correo electrónico oficial del administrador (por defecto admin@danillanos.com)
ADMIN_EMAIL=admin@danillanos.com

# Contraseña maestra de la cuenta administradora (definida por entorno)
ADMIN_DEFAULT_PASSWORD=tu_password_de_administrador_segura_aqui

# ------------------------------------------------------------------------------
# Correos Transaccionales (Resend API)
# ------------------------------------------------------------------------------
# API Key obtenida desde https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_de_resend_aqui

# Remitente verificado en Resend (o onboarding@resend.dev durante pruebas iniciales)
RESEND_FROM_EMAIL="Danillanos <no-reply@danillanos.icedlemontea.dev>"

# URL pública base para construir enlaces profundos en correos (ej. https://danillanos.icedlemontea.dev)
PUBLIC_URL=https://danillanos.icedlemontea.dev
